NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never prefix these with NEXT_PUBLIC_.
# From Supabase → Project Settings → API → service_role key. Used only by
# the cron routes in app/api/cron/ to iterate every org across RLS.
SUPABASE_SERVICE_ROLE_KEY=

# From resend.com → API Keys.
RESEND_API_KEY=
# Sender address. Use "onboarding@resend.dev" until you verify your own
# domain in Resend (that address only delivers to your own Resend account
# email while unverified).
RESEND_FROM_EMAIL=

# Shared secret Vercel Cron sends as "Authorization: Bearer <value>" when
# it calls /api/cron/*. Generate any random string.
CRON_SECRET=

# Used to build links back into the app from digest/alert emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
