NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never prefix these with NEXT_PUBLIC_.
# From Supabase → Project Settings → API → service_role key. Used only by
# the cron routes in app/api/cron/ to iterate every org across RLS.
SUPABASE_SERVICE_ROLE_KEY=

# From resend.com → API Keys.
RESEND_API_KEY=
# Sender address. Use "onboarding@resend.dev" until you verify your own
# domain in Resend (that address only delivers to your own Resend account
# email while unverified).
RESEND_FROM_EMAIL=

# Shared secret Vercel Cron sends as "Authorization: Bearer <value>" when
# it calls /api/cron/*. Generate any random string.
CRON_SECRET=

# Used to build links back into the app from digest/alert emails, and as
# the checkout success redirect.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# polar.sh → Settings → Developers → Access Tokens. Use a sandbox token
# while testing (server=sandbox); switch POLAR_SERVER to "production" and
# use a production token to go live.
POLAR_ACCESS_TOKEN=
POLAR_SERVER=sandbox

# Product IDs from `node scripts/setup-polar.mjs` (creates all 3 with a
# 14-day trial already configured — don't create them by hand in the
# dashboard, the trial won't be set consistently).
POLAR_PRODUCT_SOLO=
POLAR_PRODUCT_PRACTICE=
POLAR_PRODUCT_BILLING_CO=

# From the webhook endpoint you register in Polar (Settings → Webhooks →
# Add Endpoint, URL = <NEXT_PUBLIC_SITE_URL>/api/webhooks/polar, events:
# subscription.created, subscription.updated, subscription.revoked).
# Requires a publicly reachable URL, so this can't be registered against
# localhost — deploy first, then register, then set this.
POLAR_WEBHOOK_SECRET=

# Fase 5: public URL of the free Google Sheets template (Anyone with the
# link → Viewer, "Make a copy" enabled). Leave unset to show a "coming
# soon" placeholder on /credentialing-spreadsheet-template instead.
NEXT_PUBLIC_TEMPLATE_SHEET_URL=
